# ── Docker Environment ──
# Copy this file to .env sebelum menjalankan docker compose:
#   cp .env.docker .env

APP_NAME="E-Walas"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ewalas
DB_USERNAME=ewalas
DB_PASSWORD=ewalas_secret

DB_ROOT_PASSWORD=root_secret
APP_PORT=8080

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
